---
import Base from "../../layouts/Base.astro";

const pageTitle = "Contact | 48 Hours in California";
const pageDescription =
  "Contact 48 Hours in California with questions, destination ideas, corrections, or partnership inquiries.";
---

<Base title={pageTitle} description={pageDescription}>
  <section>
    <h1>Contact</h1>

    <p>
      We also welcome inquiries from destinations, tourism organizations,
      hotels, attractions, and other travel partners that may be a good fit
      for 48 Hours in California.
    </p>

    <h2>Get in Touch</h2>

    <p>
      For general questions, editorial suggestions, corrections, or
      partnership inquiries, please contact us at:
    </p>

    <p>
      <strong>Email:</strong>
      <a href="mailto:contact@48hoursincalifornia.com">
        contact@48hoursincalifornia.com
      </a>
    </p>

    <p>
      48 Hours in California is an independent travel publication focused
      on practical California getaways planned for real life.
    </p>
  </section>
</Base>
