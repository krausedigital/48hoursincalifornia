---
import Base from '../../layouts/Base.astro';

const pageTitle = 'Contact | 48 Hours in California';
const pageDescription =
  'Contact 48 Hours in California with questions, suggestions, destination ideas, or partnership inquiries.';
---

<Base title={pageTitle} description={pageDescription}>
  <section>
    <p>Contact 48 Hours in California</p>

    <h1>We'd love to hear from you.</h1>

    <p>
      Have a favorite California destination we should explore? A question
      about one of our itineraries? Or an idea for making a 48-hour getaway
      even better? We'd be glad to hear from you.
    </p>

    <h2>Get in touch</h2>

    <p>
      48 Hours in California is growing one getaway at a time. We welcome
      suggestions from travelers, local businesses, tourism organizations,
      hotels, restaurants, wineries, attractions, and others who know
      California well.
    </p>

    <h2>Partnerships and media</h2>

    <p>
      For destination partnerships, media inquiries, or other business
      opportunities, please contact us and tell us a little about what
      you have in mind.
    </p>

    <p>
      Contact information will be added here before the site launches.
    </p>
  </section>
</Base>
