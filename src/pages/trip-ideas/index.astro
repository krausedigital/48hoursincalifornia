---
import Base from '../../layouts/Base.astro';

const pageTitle = 'California Trip Ideas';
const pageDescription =
  'Browse practical California getaway ideas by travel style, including coastal escapes, wine country, outdoor trips, and relaxing weekends.';
---

<Base title={pageTitle} description={pageDescription}>
  <section>
    <p>California Trip Ideas</p>

    <h1>Start with the kind of getaway you want.</h1>

    <p>
      Sometimes you know you want to get away before you know exactly where
      you want to go. Trip Ideas helps you begin with the experience first.
    </p>

    <h2>Find your kind of California weekend</h2>

    <p>
      Explore coastal escapes, wine-country weekends, outdoor adventures,
      romantic getaways, food-focused trips, small towns, and relaxing
      destinations across California.
    </p>

    <p>
      As our itinerary library grows, these collections will help you quickly
      find 48-hour trips that match the way you want to travel.
    </p>

    <a href="/destinations/">Browse California Destinations</a>
  </section>
</Base>
