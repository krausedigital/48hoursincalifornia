---
import Base from '../../layouts/Base.astro';

const pageTitle = 'California Destinations';
const pageDescription =
  'Explore California destinations for practical 48-hour getaways, from wine country and the coast to mountains, deserts, and cities.';
---

<Base title={pageTitle} description={pageDescription}>
  <section>
    <p>California Destinations</p>

    <h1>Where will your next 48 hours take you?</h1>

    <p>
      California offers an extraordinary variety of places to escape for a
      couple of days. Explore destinations that work especially well for a
      practical 48-hour getaway.
    </p>
    <h2>Featured Destination</h2>

    <h3>Paso Robles</h3>

    <p>
      Rolling vineyards, a lively downtown, excellent food, and more than
      enough to fill a memorable California wine-country weekend.
    </p>

    <a href="/itineraries/paso-robles/">Explore Paso Robles</a>

    <h2>Explore California</h2>

    <p>
      We'll help you discover wine country, coastal towns, mountain escapes,
      desert destinations, and California cities — with itineraries designed
      to make a short trip feel like a real getaway.
    </p>

    <p>
      Each destination will connect you with practical ideas for where to stay,
      what to see, where to eat, and how to make the most of your 48 hours.
    </p>

    <a href="/itineraries/">Explore 48-Hour Getaways</a>
  </section>
</Base>
