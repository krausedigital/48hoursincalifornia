---
import Base from '../layouts/Base.astro';

const pageTitle = '48 Hours in California | Weekend Getaways & Travel Guides';

const pageDescription =
  'Discover relaxing California getaways for couples and independent travelers. Explore coastal towns, wine country, weekend escapes and longer California adventures.';

// Seasonal homepage hero
const heroImage = '/images/hero-california-coast-original.webp';
const heroAlt = 'Illustration of the California coastline with rugged cliffs, blue Pacific waters and golden sunset light';
---

<Base title={pageTitle} description={pageDescription}>

  <section class="homepage-hero">

    <img
      class="hero-image"
      src={heroImage}
      alt={heroAlt}
      loading="eager"
      fetchpriority="high"
    />

    <div class="hero-content">

      <h1>48 Hours in California</h1>

      <h2>Discover More. Rush Less.</h2>

      <p class="hero-tagline">
        Beautiful places. Memorable experiences.
        Time well spent together.
      </p>

      <p class="hero-introduction">
        From relaxing weekend escapes to longer California adventures,
        discover the Golden State at your own pace.
      </p>

      <a class="hero-button" href="/itineraries/">
        Explore 48-Hour Getaways
      </a>

    </div>

  </section>

  <section>
    <p>Featured Getaway</p>

    <h2>48 Hours in Paso Robles</h2>

    <img
      src="/images/paso-robles-vineyard-hero.jpg"
      alt="Vineyard landscape in Paso Robles wine country"
      style="width: 100%; height: auto; display: block;"
    />

    <p>
      Wine country without trying to see everything. Spend two days exploring
      downtown Paso Robles, nearby wineries, good food, and the landscape that
      makes this part of California worth slowing down for.
    </p>

    <a href="/itineraries/paso-robles/">
      Plan 48 Hours in Paso Robles
    </a>
  </section>

  <section>
    <p>Find Your Kind of Getaway</p>

    <h2>Choose Your California Escape</h2>

    <p>
      Start with the kind of weekend you have in mind, then find a
      48-hour getaway that fits.
    </p>

    <div>
      <h3>Wine Country</h3>
      <p>
        Vineyards, tasting rooms, good food, and California landscapes
        made for slowing down.
      </p>
      <a href="/destinations/">Explore Wine Country</a>
    </div>

    <div>
      <h3>The California Coast</h3>
      <p>
        Beaches, harbors, ocean views, and memorable stops along
        California's coastline.
      </p>
      <a href="/destinations/">Explore the Coast</a>
    </div>

    <div>
      <h3>California Towns &amp; Cities</h3>
      <p>
        Walkable downtowns, local restaurants, history, and places worth
        spending a weekend getting to know.
      </p>
      <a href="/destinations/">Explore Towns &amp; Cities</a>
    </div>
  </section>

  <section>
    <p>More California Getaways</p>

    <h2>Find Your Next 48 Hours</h2>

    <p>
      From small coastal towns to wine country and classic California
      destinations, there is always another weekend worth considering.
    </p>

    <div>
      <img
        src="/images/cambria-moonstone-beach.jpg"
        alt="Moonstone Beach along the Cambria coastline"
        style="width: 100%; height: auto; display: block;"
      />
      <h3>Cambria</h3>
      <a href="/itineraries/cambria/">Explore Cambria</a>
    </div>

    <div>
      <img
        src="/images/monterey-harbor-hero.jpg"
        alt="Monterey Harbor on the California coast"
        style="width: 100%; height: auto; display: block;"
      />
      <h3>Monterey</h3>
      <a href="/itineraries/monterey/">Explore Monterey</a>
    </div>

    <div>
      <img
        src="/images/big-sur-highway-1-hero.jpg"
        alt="Highway 1 along the Big Sur coastline"
        style="width: 100%; height: auto; display: block;"
      />
      <h3>Big Sur</h3>
      <a href="/itineraries/big-sur/">Explore Big Sur</a>
    </div>

    <div>
      <img
        src="/images/santa-barbara-hero.jpg"
        alt="Santa Barbara on the California coast"
        style="width: 100%; height: auto; display: block;"
      />
      <h3>Santa Barbara</h3>
      <a href="/itineraries/santa-barbara/">Explore Santa Barbara</a>
    </div>

    <div>
      <img
        src="/images/santa-cruz-boardwalk.jpg"
        alt="Santa Cruz Beach Boardwalk"
        style="width: 100%; height: auto; display: block;"
      />
      <h3>Santa Cruz</h3>
      <a href="/itineraries/santa-cruz/">Explore Santa Cruz</a>
    </div>

    <div>
      <img
        src="/images/sonoma-bedrock-vineyard.jpg"
        alt="Vineyard landscape in Sonoma wine country"
        style="width: 100%; height: auto; display: block;"
      />
      <h3>Sonoma</h3>
      <a href="/itineraries/sonoma/">Explore Sonoma</a>
    </div>

    <p>
      <a href="/itineraries/">View All 48-Hour Getaways</a>
    </p>
  </section>
</Base>

<style>

  /* Homepage seasonal hero */

  .homepage-hero {
    margin-bottom: 64px;
    text-align: center;
  }

  .homepage-hero > .hero-image {
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    object-fit: contain;
    display: block;
    margin: 0;
    border-radius: 8px;
  }

  .homepage-hero > .hero-content {
    max-width: 850px;
    margin: 0 auto;
    padding: 32px 16px 12px;
  }

  .hero-content h1 {
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    line-height: 1.15;
    margin: 0 0 12px;
    letter-spacing: -0.025em;
  }

  .hero-content h2 {
    font-size: clamp(1.5rem, 3.5vw, 2.3rem);
    line-height: 1.25;
    font-weight: 600;
    color: #36594d;
    margin: 0 0 22px;
  }

  .hero-tagline {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.6;
    font-weight: 500;
    margin: 0 auto 12px;
  }

  .hero-introduction {
    max-width: 680px;
    font-size: 1.1rem;
    line-height: 1.7;
    margin: 0 auto 26px;
  }

  .hero-content .hero-button {
    display: inline-block;
    padding: 14px 26px;
    background-color: #36594d;
    color: #ffffff;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 6px;
    transition: background-color 0.2s ease;
  }

  .hero-content .hero-button:hover {
    background-color: #28443a;
    color: #ffffff;
    text-decoration: none;
  }

  .hero-content .hero-button:focus-visible {
    outline: 3px solid #36594d;
    outline-offset: 4px;
  }

  /* Existing homepage sections */

  section {
    margin-bottom: 72px;
  }

  section > p:first-child {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  section > img {
    margin: 24px 0;
    border-radius: 6px;
  }

  section > div {
    margin: 32px 0;
  }

  section > div img {
    width: 100%;
    height: 280px;
    object-fit: cover;
    display: block;
    margin-bottom: 16px;
    border-radius: 6px;
  }

  section > div h3 {
    margin-bottom: 8px;
  }

  @media (max-width: 600px) {

    .homepage-hero {
      margin-bottom: 48px;
    }

    .homepage-hero > .hero-content {
      padding: 24px 8px 8px;
    }

    .hero-introduction {
      font-size: 1rem;
    }

    .hero-content .hero-button {
      padding: 12px 20px;
    }

  }

  @media (min-width: 760px) {

    section:last-of-type {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px;
    }

    section:last-of-type > p,
    section:last-of-type > h2 {
      grid-column: 1 / -1;
    }

    section:last-of-type > div {
      margin: 0;
    }

  }

</style>
